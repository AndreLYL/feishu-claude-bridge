# Feishu App Credentials
FEISHU_APP_ID=cli_xxxxx
FEISHU_APP_SECRET=xxxxx

# Chat ID where the bot lives (find by sending message to bot, check bridge logs)
ALLOWED_CHAT_ID=oc_xxxxx

# Hook server port for permission requests (default: 19280)
HOOK_SERVER_PORT=19280

# Multi-session configuration (optional)
# Maximum number of concurrent Claude Code sessions (default: 5)
MAX_SESSIONS=5

# Path to session store file (default: ~/.feishu-claude-bridge/sessions.json)
# SESSION_STORE_PATH=/path/to/custom/sessions.json
